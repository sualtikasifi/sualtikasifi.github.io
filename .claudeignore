# --- Buyuk bagimliliklar / derleme ciktilari (asil token tuketicisi) ---
# farm-app/node_modules ~671MB, farm-app/.next ~589MB, farm-app/out ~5MB.
farm-app/node_modules/
farm-app/.next/
farm-app/out/

# --- GitHub Pages'e yayinlanan statik site kopyasi (repo kokunde) ---
# Bunlar kaynak kod degil, sadece deploy sonrasi yayinlanan HTML/txt
# kopyalari (farm-app/out/ ile ayni icerik, repo kokune de kopyalaniyor).
/_next/
*.html
*.txt

# --- Log / gecici / onbellek dosyalari ---
*.log
*.tmp
.cache/

# --- Ekran goruntusu / veri dump'lari (varsa) ---
screenshots/
*.json.bak

# --- Ortam ve gizli dosyalar ---
.env
.env.local
farm-app/.env
farm-app/.env.local
firebase-adminsdk*.json
google-services.json

# --- Surum kontrolu ici ---
.git/
